      "checkConstraints": {
        "recruiters_complete_scores": {
          "name": "recruiters_complete_scores",
          "value": "\n        (\"recruiters\".\"role_score\" IS NULL AND \"recruiters\".\"hiring_signal_score\" IS NULL\n            AND \"recruiters\".\"human_signal_score\" IS NULL AND \"recruiters\".\"total_score\" IS NULL)\n        OR (\"recruiters\".\"role_score\" IS NOT NULL AND \"recruiters\".\"hiring_signal_score\" IS NOT NULL\n            AND \"recruiters\".\"human_signal_score\" IS NOT NULL AND \"recruiters\".\"total_score\" IS NOT NULL\n            AND \"recruiters\".\"reason\" IS NOT NULL)\n    "
        },
        "recruiters_valid_scores": {
          "name": "recruiters_valid_scores",
          "value": "\n        \"recruiters\".\"total_score\" IS NULL OR (\n            \"recruiters\".\"role_score\" IN (0, 35, 70)\n            AND \"recruiters\".\"hiring_signal_score\" BETWEEN 0 AND 15\n            AND \"recruiters\".\"human_signal_score\" BETWEEN 0 AND 15\n            AND \"recruiters\".\"total_score\" = \"recruiters\".\"role_score\" + \"recruiters\".\"hiring_signal_score\" + \"recruiters\".\"human_signal_score\"\n        )\n    "
        },
        "recruiters_selected_has_scores": {
          "name": "recruiters_selected_has_scores",
          "value": "\"recruiters\".\"selected\" = 0 OR \"recruiters\".\"total_score\" IS NOT NULL"
        }
      }
