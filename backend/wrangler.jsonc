{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-08",
	"d1_databases": [
		{
			"binding": "job_app_db",
			"database_name": "job-app-db",
			"database_id": "70392e69-d89d-4842-b746-d34d094c82bb",
			"migrations_dir": "drizzle"
		}
	],
	"triggers": {
		"crons": ["*/5 * * * *"]
	}
